<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LeaveRequest" targetNamespace="http://srmist.edu/leave-request">
<bpmn:process id="leave-request" name="Leave Request" isExecutable="true">
<bpmn:startEvent id="StartEvent_1" name="Leave Requested"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="ApproveLeave" name="Approve Leave"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="EndEvent_1" name="Leave Process Ended"><bpmn:incoming>Flow_2</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ApproveLeave"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="ApproveLeave" targetRef="EndEvent_1"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="BPMNDiagram_LeaveRequest"><bpmndi:BPMNPlane id="BPMNPlane_LeaveRequest" bpmnElement="leave-request">
<bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="160" y="100" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ApproveLeave_di" bpmnElement="ApproveLeave"><dc:Bounds x="260" y="78" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1"><dc:Bounds x="445" y="100" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="196" y="118"/><di:waypoint x="260" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="380" y="118"/><di:waypoint x="445" y="118"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>